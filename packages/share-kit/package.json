{
	"name": "@xsynaptic/share-kit",
	"version": "0.1.0",
	"description": "A share dialog custom element for posting a page to social platforms",
	"type": "module",
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/astro-lab.git",
		"directory": "packages/share-kit"
	},
	"homepage": "https://github.com/xsynaptic/astro-lab/tree/main/packages/share-kit#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/astro-lab/issues"
	},
	"keywords": [
		"share",
		"social",
		"web-components",
