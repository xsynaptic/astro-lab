{
	"name": "@xsynaptic/astro-scripts",
	"version": "0.14.0",
	"description": "Plumbing for an Astro project's scripts package: a command runner, output with interchangeable reporters, and a bridge into Astro's content layer",
	"type": "module",
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/astro-lab.git",
		"directory": "packages/astro-scripts"
	},
	"homepage": "https://github.com/xsynaptic/astro-lab/tree/main/packages/astro-scripts#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/astro-lab/issues"
	},
	"keywords": [
		"astro",
		"withastro",
		"cli",
		"scripts",
		"content-collections",
		"vite"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"chalk": "^6.0.1",
		"ky": "^2.2.0",
		"ora": "^9.4.1"
	},
	"peerDependencies": {
		"astro": "^7.4.2",
		"satteri": "^0.10.0 || ^0.11.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"satteri": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"astro": "^7.4.2",
		"satteri": "^0.11.5",
		"vite": "^8.3.5",
		"zx": "^8.8.5"
	}
}
