{
	"name": "@xsynaptic/eslint-config",
	"version": "6.10.0",
	"description": "An ESLint flat-config factory for TypeScript projects",
	"type": "module",
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/astro-lab.git",
		"directory": "packages/eslint-config"
	},
	"homepage": "https://github.com/xsynaptic/astro-lab/tree/main/packages/eslint-config#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/astro-lab/issues"
	},
	"keywords": [
		"eslint",
		"eslint-config",
		"typescript"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch"
	},
	"dependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@vitest/eslint-plugin": "^1.6.28",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-perfectionist": "^5.14.0",
		"eslint-plugin-unicorn": "^80.0.0",
		"eslint-plugin-wc": "^3.1.0",
		"globals": "^17.14.0",
		"typescript-eslint": "^8.73.0"
	}
}
