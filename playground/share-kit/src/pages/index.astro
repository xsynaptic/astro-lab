---
import '@fontsource-variable/plus-jakarta-sans';

import '../styles/playground.css';
import ShareKitSpecimen from '../components/share-kit-specimen.astro';
import { getSpecimens } from '../lib/specimens.js';

const specimens = getSpecimens();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<title>share-kit playground</title>
	</head>
	<body>
		<h1>share-kit playground</h1>
		<p>Each button opens the dialog as it would look in one situation.</p>
		<ul class="specimens">
			{specimens.map((specimen) => (
				<li>
					<ShareKitSpecimen {...specimen} />
				</li>
			))}
		</ul>
		<footer class="event-log">
			<p>
				Last <code>share-kit:action</code> event, read by the e2e tests:
			</p>
			<output data-event-log>none</output>
		</footer>
		<script>
			import {
				defineShareKit,
				shareKitActionEventName,
				shareKitInterfaceIcons,
			} from '@xsynaptic/share-kit';

			import { destinations } from '../lib/destinations.js';

			const eventLog = document.querySelector('[data-event-log]');

			defineShareKit({
				destinations,
				icons: async () => {
					const { brandIcons } = await import('../lib/icons.js');

					return { ...shareKitInterfaceIcons, ...brandIcons };
				},
			});

			document.addEventListener(shareKitActionEventName, ({ detail }) => {
				if (eventLog) eventLog.textContent = JSON.stringify(detail);
			});
		</script>
	</body>
</html>
