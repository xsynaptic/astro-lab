---
// `context` is stamped by the satteri-img-group plugin
interface Props {
	context?: string;
	src: string;
}

const { context, src } = Astro.props;
---

<figure class="img" data-context={context}>
	<img alt="" height="80" src={src} width="120" />
	<figcaption>context=<code>{context}</code></figcaption>
</figure>

<style>
	.img {
		margin: 0;
	}

	.img img {
		display: block;
		background: #eee;
	}

	.img figcaption {
		font-family: monospace;
		font-size: 0.75rem;
		color: #555;
	}
</style>
