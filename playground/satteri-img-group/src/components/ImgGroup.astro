---
// `context` and `imageCount` are stamped by the satteri-img-group plugin
interface Props {
	context?: string;
	layout?: string;
	imageCount?: string;
}

const { context, layout = 'default', imageCount } = Astro.props;
---

<div class="img-group" data-layout={layout}>
	<p class="img-group__meta">
		context=<code>{context}</code> layout=<code>{layout}</code> imageCount=<code>{imageCount}</code>
	</p>
	<div class="img-group__items" data-context={context}>
		<slot />
	</div>
</div>

<style>
	.img-group {
		margin: 2rem 0;
		padding: 1rem;
		border: 1px solid #ddd;
		border-radius: 8px;
	}

	.img-group__meta {
		margin: 0 0 0.75rem;
		font-family: monospace;
		font-size: 0.85rem;
		color: #555;
	}

	.img-group__items {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.img-group__items[data-context='masonry'] {
		display: block;
		columns: 3;
		column-gap: 0.75rem;
	}

	.img-group__items[data-context='masonry'] > :global(*) {
		margin-bottom: 0.75rem;
		break-inside: avoid;
	}

	.img-group__items[data-context='carousel'] {
		flex-wrap: nowrap;
		overflow-x: auto;
	}

	.img-group[data-layout='wide'] {
		margin-inline: -2rem;
	}

	.img-group[data-layout='full'] {
		margin-inline: -4rem;
	}
</style>
